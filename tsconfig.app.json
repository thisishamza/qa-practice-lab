{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "tests/shop/views.test.tsx",
    "tests/shop/cart-views.test.tsx",
    "tests/shop/checkout-views.test.tsx",
    "tests/pages/curriculum-views.test.tsx",
    "tests/pages/progress-page.test.tsx",
    "tests/pages/recommended-path.test.tsx",
    "tests/pages/evaluation-transparency.test.tsx",
    "tests/pages/about-page.test.tsx",
    "tests/practice/bug-report-form.test.tsx",
    "tests/practice/hint-reveal-ui.test.tsx",
    "tests/pages/api-reference-page.test.tsx",
    "tests/pages/api-lab-page.test.tsx",
    "tests/pages/database-hub.test.tsx",
    "tests/pages/database-playground.test.tsx",
    "tests/pages/database-schema-explorer.test.tsx",
    "tests/pages/sql-editor.test.tsx",
    "tests/pages/contract-pages.test.tsx",
    "tests/lib/sql-client.test.ts",
    "tests/database/exercise-workspace.test.tsx",
    "tests/pages/topbar-cart-visibility.test.tsx"
  ],
  "exclude": [
    "src/server"
  ]
}