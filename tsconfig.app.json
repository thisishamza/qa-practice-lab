{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["vite/client"]
  },
  "include": ["src", "tests/shop/views.test.tsx", "tests/shop/cart-views.test.tsx", "tests/shop/checkout-views.test.tsx", "tests/pages/curriculum-views.test.tsx", "tests/pages/progress-page.test.tsx", "tests/pages/recommended-path.test.tsx", "tests/pages/evaluation-transparency.test.tsx", "tests/pages/about-page.test.tsx", "tests/practice/bug-report-form.test.tsx", "tests/practice/hint-reveal-ui.test.tsx"],
  "exclude": ["src/server"]
}
