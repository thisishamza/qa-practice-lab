{
  "name": "qa-practice-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A safe, phased practice environment for software testing skills.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:web && concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "npm run typecheck && vite build",
    "build:web": "vite build",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.functions.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:migrate:local": "wrangler d1 migrations apply qa-practice-lab-db --local",
    "db:migrations:list": "wrangler d1 migrations list qa-practice-lab-db --local",
    "db:cleanup:local": "wrangler d1 execute qa-practice-lab-db --local --file=db/maintenance/cleanup.sql",
    "db:reset:local": "wrangler d1 execute qa-practice-lab-db --local --file=db/maintenance/reset-local.sql"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
