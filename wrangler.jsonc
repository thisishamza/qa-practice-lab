{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qa-practice-lab",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qa-practice-lab-db",
      // Production D1 database (created 2026-11-16). IDs are not secrets.
